<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Restaurant Brasileira Section -->
    <template id="s_restaurant_info" name="Restaurante Brasileiro">
<section class="s_restaurant_info s_ha_restaurant s_ha_brasileira pt64 pb64" data-snippet="s_restaurant_info" data-name="Restaurante Brasileiro">
            <div class="container">
                <div class="ha-sub-title brasileira-tag">Restaurante Brasileiro</div>
                <h2 class="brasileira-title">
                    Brazilian cuisine <em>right in the hotel</em>
                </h2>
                <div class="row align-items-center mt-5">
                    <div class="col-lg-6 mb-4 mb-lg-0">
                        <div class="row g-2">
                            <div class="col-6">
                                <div class="ha-img-hover-zoom brasileira-img-tall">
                                    <img src="/theme_hotel_arena/static/src/img/restaurant/rafael.webp" alt="Chef Rafael, Restaurante Brasileiro" class="img-fluid" loading="lazy"/>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="ha-img-hover-zoom brasileira-img-short mb-2">
                                    <img src="/theme_hotel_arena/static/src/img/restaurant/jidlo-2.webp" alt="Starters at Restaurante Brasileiro" class="img-fluid" loading="lazy"/>
                                </div>
                                <div class="ha-img-hover-zoom brasileira-img-short">
                                    <img src="/theme_hotel_arena/static/src/img/restaurant/jidlo-3.webp" alt="Soup at Restaurante Brasileiro" class="img-fluid" loading="lazy"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <h3 class="brasileira-heading">Authentic flavours of Brazil by chef Rafael</h3>
                        <p class="brasileira-text">
                            Restaurante Brasileiro brings Brazilian cooking with an international reach to the heart of Hotel Arena. Chef Rafael serves authentic recipes from Brazil alongside Czech and international specialities.
                        </p>
                        <p class="brasileira-text">
                            Seating for 110 including 2 private lounges and a summer terrace with 60 seats. There is also a bar, ideal for meetings and business talks.
                        </p>
                        <div class="mt-4">
                            <a href="https://www.brasileiroarena.cz/" target="_blank" rel="noopener" class="ha-btn-brasileira me-2 mb-2">Restaurant</a>
                            <a href="https://objedname.eu/eshop-brasileiroarena-cz" target="_blank" rel="noopener" class="ha-btn-outline-brasileira me-2 mb-2">Menu</a>
                            <a href="https://reservation.dish.co/landingPage/hydra-db1d2020-4c4b-11ec-a15c-1d608852d06f" target="_blank" rel="noopener" class="ha-btn-outline-brasileira mb-2">Book a table</a>
                        </div>
                        <div class="brasileira-hours mt-4 pt-4">
                            <div class="row">
                                <div class="col-sm-6 mb-3 mb-sm-0">
                                    <strong class="brasileira-hours-label">Restaurant</strong>
                                    <span class="brasileira-hours-text">
                                        Mon — Thu · 15:00 — 23:00<br/>
                                        Fri — Sat · 15:00 — 00:00<br/>
                                        Sun · 15:00 — 23:00
                                    </span>
                                </div>
                                <div class="col-sm-6">
                                    <strong class="brasileira-hours-label">Breakfast</strong>
                                    <span class="brasileira-hours-text">
                                        Mon — Fri · 6:30 — 9:30<br/>
                                        Sat — Sun · 7:00 — 10:00
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Parallax Bar Section -->
    <template id="s_parallax_bar" name="Parallax Bar">
        <section class="s_parallax_bar s_ha_parallax_bar o_cc o_cc5 pt0 pb0 o_colored_level" data-snippet="s_parallax_bar" data-name="Parallax Bar">
            <div class="ha-parallax-section" style="background-image: url('/theme_hotel_arena/static/src/img/parallax/paralax-bar.webp');">
                <div class="ha-overlay-dark" style="position:absolute;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.6);"/>
                <div class="container" style="position: relative; z-index: 1;">
                    <div class="text-center">
                        <h2 class="text-white" style="text-transform: uppercase; margin-bottom: 20px;">
                            Hotel Bar</h2>
                        <p class="text-white" style="max-width: 600px; margin: 0 auto 30px; font-size: 16px;">
                            A stylish bar with a wide choice of cocktails, wines and other drinks. The ideal place to unwind after a demanding day.</p>
                        <a href="/restaurace-a-bar" class="ha-btn-outline-white" style="display:inline-block;padding:10px 30px;border:2px solid #fff;color:#fff;text-transform:uppercase;font-weight:600;text-decoration:none;">
                            More information</a>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>