<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Room Prices Table -->
    <template id="s_room_prices" name="Room pricelist">
<section class="s_room_prices s_ha_room_prices o_cc o_cc1 pt104 pb104 o_colored_level" data-snippet="s_room_prices" data-name="Room pricelist">
            <div class="container">
                <div class="text-center" style="margin-bottom:4rem;">
                    <div class="section-tag" style="justify-content:center;">Our prices</div>
                    <h2 class="section-title">Accommodation pricelist</h2>
                </div>
                <div class="table-responsive">
                    <table class="ha-price-table">
                        <thead>
                            <tr>
                                <th>Room type</th>
                                <th>Bed count</th>
                                <th>1 person</th>
                                <th>2 people</th>
                                <th>3 people</th>
                                <th>4 people</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Standard (2 separate beds)</strong></td>
                                <td>2</td>
                                <td class="ha-price-cell">CZK 1,600</td>
                                <td class="ha-price-cell">CZK 2,350</td>
                                <td class="ha-price-cell">—</td>
                                <td class="ha-price-cell">—</td>
                            </tr>
                            <tr>
                                <td><strong>Standard (double bed)</strong></td>
                                <td>1</td>
                                <td class="ha-price-cell">CZK 2,250</td>
                                <td class="ha-price-cell">CZK 2,350</td>
                                <td class="ha-price-cell">—</td>
                                <td class="ha-price-cell">—</td>
                            </tr>
                            <tr>
                                <td><strong>Barrier-free room</strong></td>
                                <td>2</td>
                                <td class="ha-price-cell">CZK 2,450</td>
                                <td class="ha-price-cell">CZK 3,200</td>
                                <td class="ha-price-cell">—</td>
                                <td class="ha-price-cell">—</td>
                            </tr>
                            <tr>
                                <td><strong>Family room</strong></td>
                                <td>4</td>
                                <td class="ha-price-cell">CZK 2,600</td>
                                <td class="ha-price-cell">CZK 3,200</td>
                                <td class="ha-price-cell">CZK 3,800</td>
                                <td class="ha-price-cell">CZK 4,400</td>
                            </tr>
                            <tr>
                                <td><strong>Deluxe Queen (2 queen beds)</strong></td>
                                <td>4</td>
                                <td class="ha-price-cell">CZK 3,600</td>
                                <td class="ha-price-cell">CZK 4,200</td>
                                <td class="ha-price-cell">CZK 4,800</td>
                                <td class="ha-price-cell">CZK 5,400</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Validity, the way the printed pricelist states it -->
                <p class="ha-price-valid"><i class="fa fa-calendar"/> The pricelist is valid from 1 October 2026.</p>

                <!-- Included in price -->
                <div class="mt-5">
                    <h4 style="text-transform: uppercase; margin-bottom: 20px;">The accommodation rate includes:</h4>
                    <div class="row">
                        <div class="col-md-6">
                            <ul class="ha-iconlist">
                                <li>Buffet-style breakfast</li>
                                <li>Satellite television and a safe in the room</li>
                                <li>Wireless internet throughout the hotel</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <ul class="ha-iconlist">
                                <li>VAT and city tax</li>
                                <li>24/7 reception</li>
                                <li>Free parking in the hotel car park, monitored by CCTV</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Additional services -->
                <div class="mt-4">
                    <h4 style="text-transform: uppercase; margin-bottom: 20px;">Additional services:</h4>
                    <ul class="ha-iconlist">
                        <li>Accommodation for children under 3 — free of charge</li>
                        <li>An extra bed for a child is available in selected rooms</li>
                        <li>Half board or full board (group stays, for an extra charge)</li>
                        <li>High-speed internet access (for an extra charge)</li>
                        <li>Laundry and ironing (for an extra charge)</li>
                        <li>Ticket booking</li>
                    </ul>
                </div>

                <!-- Pet policy -->
                <div class="mt-4 p-3" style="background:rgba(240,112,112,0.06);border-left:4px solid #F07070;">
                    <p style="margin: 0; font-weight: 600;">
                        <i class="fa fa-paw" style="color:#F07070;margin-right:8px;"/>
                        Pets are not allowed.
                    </p>
                </div>
            </div>
        </section>
    </template>

</odoo>