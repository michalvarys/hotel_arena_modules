<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Restaurant Guru award badge.

         The old arenahotel.cz embeds Restaurant Guru's own widget: a
         stylesheet from awards.infcdn.net plus a div with an inline onclick
         handler. Rebuilt here as a plain link with the styling in our own
         SCSS, for three reasons:
           - no <script> or onclick belongs in the arch,
           - the badge would break the day that CDN moves or goes away,
           - a real <a> is what a crawler and a keyboard user need; the widget
             only reacts to a mouse click on the wrapper.
         The year stays 2023, the award the hotel actually holds. -->

    <template id="s_award_badge" name="Restaurant Guru badge">
        <section class="s_award_badge s_ha_award o_cc o_cc1 pt32 pb64 o_colored_level"
                 data-snippet="s_award_badge"
                 data-name="Restaurant Guru badge">
            <div class="container text-center">
                <a href="https://restaurantguru.com/Hotel-Arena-Chomutov-Chomutov"
                   class="ha-award" target="_blank" rel="noopener">
                    <span class="ha-award-name">Hotel Aréna - Chomutov</span>
                    <svg class="ha-award-mark" viewBox="0 0 120 38" aria-hidden="true">
                        <path d="M6 32h108" />
                        <path d="M18 32 L42 12 L60 26 L78 12 L102 32" />
                        <path d="M42 12 L42 32 M60 26 L60 32 M78 12 L78 32" />
                        <path d="M30 22 L30 32 M90 22 L90 32" />
                    </svg>
                    <span class="ha-award-rec">Recommended</span>
                    <span class="ha-award-src">Restaurant Guru</span>
                    <span class="ha-award-year">2023</span>
                </a>
            </div>
        </section>
    </template>

</odoo>
