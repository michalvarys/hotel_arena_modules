<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Rooms Full Listing (Alternating Layout) -->
    <template id="s_rooms_listing" name="Rooms - list">
<section class="s_rooms_listing s_ha_rooms_listing o_cc o_cc1 pt104 pb104 o_colored_level" data-snippet="s_rooms_listing" data-name="Rooms - list">
            <div class="container">
                <div class="ha-room-listing">
                    <!-- Standard Double (twin beds) -->
                    <div class="ha-room-item">
                        <div class="ha-room-item-img">
                            <img src="/theme_hotel_arena/static/src/img/rooms/pokoj-standard.webp" alt="Standard double room" loading="lazy"/>
                        </div>
                        <div class="ha-room-item-content">
                            <div class="ha-sub-title">Double</div>
                            <h3>STANDARD DOUBLE ROOM</h3>
                            <div class="ha-room-item-price">from CZK 1,600 <small>/ night</small></div>
                            <p>A comfortable double room with either two separate beds or a double bed. The room has air conditioning, free Wi-Fi, satellite television and a safe.</p>
                            <ul class="ha-room-amenities">
                                <li><i class="fa fa-wifi"/> WiFi</li>
                                <li><i class="fa fa-snowflake-o"/> Air conditioning</li>
                                <li><i class="fa fa-tv"/> Satellite TV</li>
                                <li><i class="fa fa-bath"/> Bathroom</li>
                                <li><i class="fa fa-lock"/> Safe</li>
                            </ul>
                        </div>
                    </div>
                    <!-- Barrier-free -->
                    <div class="ha-room-item">
                        <div class="ha-room-item-img">
                            <img src="/theme_hotel_arena/static/src/img/rooms/bezbarierovy-pokoj.webp" alt="Barrier-free double room" loading="lazy"/>
                        </div>
                        <div class="ha-room-item-content">
                            <div class="ha-sub-title">Barrier-free</div>
                            <h3>BARRIER-FREE DOUBLE ROOM</h3>
                            <div class="ha-room-item-price">from CZK 2,450 <small>/ night</small></div>
                            <p>A barrier-free double room with full access for guests with reduced mobility. A lift provides step-free access to every floor of the hotel.</p>
                            <ul class="ha-room-amenities">
                                <li><i class="fa fa-wifi"/> WiFi</li>
                                <li><i class="fa fa-snowflake-o"/> Air conditioning</li>
                                <li><i class="fa fa-tv"/> Satellite TV</li>
                                <li><i class="fa fa-wheelchair"/> Barrier-free</li>
                            </ul>
                        </div>
                    </div>
                    <!-- Family Room -->
                    <div class="ha-room-item">
                        <div class="ha-room-item-img">
                            <img src="/theme_hotel_arena/static/src/img/rooms/rodinny-pokoj.webp" alt="Family room" loading="lazy"/>
                        </div>
                        <div class="ha-room-item-content">
                            <div class="ha-sub-title">Quadruple</div>
                            <h3>FAMILY ROOM</h3>
                            <div class="ha-room-item-price">from CZK 2,600 <small>/ night</small></div>
                            <p>A spacious family room with 4 beds. Suitable for families with children or groups of friends.</p>
                            <ul class="ha-room-amenities">
                                <li><i class="fa fa-wifi"/> WiFi</li>
                                <li><i class="fa fa-snowflake-o"/> Air conditioning</li>
                                <li><i class="fa fa-tv"/> Satellite TV</li>
                                <li><i class="fa fa-bath"/> Bathroom</li>
                            </ul>
                        </div>
                    </div>
                    <!-- Deluxe Queen -->
                    <div class="ha-room-item">
                        <div class="ha-room-item-img">
                            <img src="/theme_hotel_arena/static/src/img/rooms/pokoj-deluxe-queen.webp" alt="Deluxe Queen room" loading="lazy"/>
                        </div>
                        <div class="ha-room-item-content">
                            <div class="ha-sub-title">Luxury</div>
                            <h3>DELUXE QUEEN ROOM</h3>
                            <div class="ha-room-item-price">from CZK 3,600 <small>/ night</small></div>
                            <p>A luxury room with two queen size beds. It offers maximum comfort and elegance for discerning guests.</p>
                            <ul class="ha-room-amenities">
                                <li><i class="fa fa-wifi"/> WiFi</li>
                                <li><i class="fa fa-snowflake-o"/> Air conditioning</li>
                                <li><i class="fa fa-tv"/> Satellite TV</li>
                                <li><i class="fa fa-bath"/> Bathroom</li>
                                <li><i class="fa fa-lock"/> Safe</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Rooms Intro Text -->
    <template id="s_rooms_intro" name="Rooms - intro">
<section class="s_rooms_intro s_ha_rooms_intro o_cc o_cc1 pt104 pb104 o_colored_level" data-snippet="s_rooms_intro" data-name="Rooms - intro">
            <div class="container text-center">
                <div class="section-tag" style="justify-content:center;">Our accommodation</div>
                <h2 class="section-title">Rooms &amp; Apartments</h2>
                <p style="max-width:700px;margin:0 auto;color:#C5C2BA;line-height:1.8;font-size:1.25rem;">
                    The rooms at Hotel Arena are marked by a fresh, modern design. Each room has its own bathroom, satellite television, a safe and individually controlled air conditioning. A lift provides step-free access to every floor of the hotel.</p>
            </div>
        </section>
    </template>

</odoo>