<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hero Slider — Full-screen dark theme with parallax zoom -->
    <template id="s_hero_slider" name="Hotel Arena Slider">
        <section class="s_ha_hero_slider o_cc o_cc5 pt0 pb0 o_colored_level"
                 data-snippet="s_hero_slider"
                 data-name="Hotel Arena Slider"
                 style="position:relative; height:100vh; min-height:700px; display:flex; align-items:flex-end; overflow:hidden;">
            <!-- Slide backgrounds -->
            <div style="position:absolute;inset:0;overflow:hidden;">
                <div style="position:absolute;inset:0;
                     background-image:url('/theme_hotel_arena/static/src/img/parallax/paralax-hotel.webp');
                     background-size:cover;background-position:center;"></div>
                <div style="position:absolute;inset:0;
                     background:linear-gradient(180deg,rgba(26,26,34,0.45) 0%,rgba(26,26,34,0.25) 30%,rgba(26,26,34,0.55) 60%,rgba(26,26,34,0.97) 100%),
                     linear-gradient(135deg,rgba(26,26,34,0.6) 0%,transparent 50%);
                     pointer-events:none;z-index:1;"></div>
                <!-- Crimson glow bottom-left -->
                <div style="position:absolute;bottom:0;left:0;width:60%;height:70%;
                     background:radial-gradient(ellipse at bottom left,rgba(139,26,43,0.25) 0%,transparent 65%);
                     pointer-events:none;z-index:1;"></div>
            </div>

            <!-- Brand Stripe -->
            <div class="brand-stripe" style="position:absolute;bottom:0;left:0;right:0;z-index:10;"></div>

            <!-- Content -->
            <div class="container" style="position:relative;z-index:2;padding-bottom:6rem;max-width:800px;">
                <div class="section-tag" style="color:#F07070;margin-bottom:1.5rem;">
                    Chomutov, Česká republika
                </div>
                <h1 style="font-family:'Playfair Display',serif;font-size:clamp(3rem,6vw,5.5rem);
                    font-weight:400;line-height:1.1;letter-spacing:-0.02em;color:#FAFAF8;margin-bottom:1.5rem;">
                    Kde sport potkává <em style="font-style:italic;color:#F07070;">eleganci</em>
                </h1>
                <p style="font-size:1.3rem;line-height:1.7;color:rgba(255,255,255,0.9);
                   max-width:500px;margin-bottom:2.5rem;">
                    Moderní hotel v srdci sportovně-relaxačního centra u Kamencového jezera.
                    96 pokojů, restaurace, concierge — vše pro váš dokonalý pobyt.
                </p>
                <div style="display:flex;gap:1.5rem;align-items:center;flex-wrap:wrap;">
                    <a href="https://www.secure-hotel-booking.com/Hotel-Arena/JJZW/cs?hotelId=24506"
                       class="btn-reserve" target="_blank" rel="noopener">Rezervovat pobyt</a>
                    <a href="/ubytovani" class="btn-outline">Prohlédnout pokoje</a>
                </div>
            </div>

            <!-- EV Badge -->
            <div class="ev-badge" style="position:absolute;bottom:2rem;right:10rem;z-index:10;">
                <i class="fa fa-bolt" style="color:#F07070;"/>
                Nabíjecí stanice ČEZ pro elektromobily
            </div>
        </section>
    </template>

</odoo>
