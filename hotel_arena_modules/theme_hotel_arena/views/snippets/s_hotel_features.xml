<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Features — Numbered list with image (dark card bg) -->
    <template id="s_hotel_features" name="Hotel facilities">
        <section class="s_hotel_features s_ha_hotel_features o_cc o_cc2 pt104 pb104 o_colored_level" data-snippet="s_hotel_features" data-name="Hotel facilities">
            <div class="container">
                <div class="features-layout">
                    <div class="features-img reveal">
                        <img src="/theme_hotel_arena/static/src/img/homepage/o-nas2.webp" alt="Hotel Arena facilities" loading="lazy"/>
                    </div>
                    <div class="features-list reveal">
                        <div class="section-tag">Facilities</div>
                        <h2 class="section-title">Comfort in every <em>detail</em></h2>
                        <div class="feature-item">
                            <div class="feature-num">01</div>
                            <div class="feature-text">
                                <h3>Air conditioning &amp; safe</h3>
                                <p>Every room has individually controlled air conditioning and a security safe.</p>
                            </div>
                        </div>
                        <div class="feature-item">
                            <div class="feature-num">02</div>
                            <div class="feature-text">
                                <h3>Satellite TV &amp; Wi-Fi</h3>
                                <p>An LCD television with satellite reception and free wireless internet throughout the hotel.</p>
                            </div>
                        </div>
                        <div class="feature-item">
                            <div class="feature-num">03</div>
                            <div class="feature-text">
                                <h3>24/7 reception</h3>
                                <p>Reception available 24 hours a day. Check in at any time, concierge services on request.</p>
                            </div>
                        </div>
                        <div class="feature-item">
                            <div class="feature-num">04</div>
                            <div class="feature-text">
                                <h3>Guarded parking</h3>
                                <p>Our own CCTV-monitored car park, free for all guests.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>