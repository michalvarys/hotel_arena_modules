<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- About Hotel — Exterior showcase with stats (dark theme) -->
    <template id="s_about_hotel" name="About us">
<section class="s_about_hotel s_ha_about_hotel o_cc o_cc1 pt104 pb104 o_colored_level" data-snippet="s_about_hotel" data-name="About us">
            <div class="container">
                <div class="exterior-layout">
                    <div class="exterior-img reveal">
                        <img src="/theme_hotel_arena/static/src/img/parallax/paralax-hotel.webp" alt="Hotel Arena Chomutov" loading="lazy"/>
                        <div class="exterior-badge">
                            <i class="fa fa-map-marker" style="color:#F07070;"/>
                            <span>Chomutov</span> by Kamencové Lake
                        </div>
                    </div>
                    <div class="reveal">
                        <div class="section-tag">About us</div>
                        <h2 class="section-title">Sports and relaxation <em>facilities</em></h2>
                        <p class="section-desc" style="margin-bottom:2rem;">
                            The newly built Hotel Arena stands in the sports and relaxation centre in Zadní Vinohrady on the edge of Chomutov, letting guests spend their free time actively right next to the unique Kamencové Lake.
                        </p>
                        <p style="font-size:1.15rem;line-height:1.7;color:#C5C2BA;">
                            The hotel is furnished in a modern design with a total capacity of 210 beds. Several of the 96 double rooms are barrier-free.
                        </p>
                        <div class="exterior-stats">
                            <div>
                                <div class="stat-num">96</div>
                                <div class="stat-label">Rooms</div>
                            </div>
                            <div>
                                <div class="stat-num">210</div>
                                <div class="stat-label">Beds</div>
                            </div>
                            <div>
                                <div class="stat-num">24/7</div>
                                <div class="stat-label">Reception</div>
                            </div>
                            <div>
                                <div class="stat-num">★★★</div>
                                <div class="stat-label">Hotel</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Hotel Services (for /o-hotelu page) -->
    <template id="s_hotel_services" name="Services for our guests">
<section class="s_hotel_services s_ha_hotel_services o_cc o_cc2 pt104 pb104 o_colored_level" data-snippet="s_hotel_services" data-name="Services for our guests">
            <div class="container text-center">
                <div class="section-tag" style="justify-content:center;">
                    <span style="display:none;">—</span>For our guests
                </div>
                <h2 class="section-title">Services for <em>guests</em></h2>
                <p class="section-desc" style="max-width:650px;margin:0 auto 4rem;">
                    Everything you need for a carefree stay.</p>
                <div class="concierge-grid">
                    <div class="concierge-item">
                        <div class="concierge-icon"><i class="fa fa-coffee"/></div>
                        <h4>Buffet breakfast</h4>
                        <p>A generous breakfast buffet every morning.</p>
                    </div>
                    <div class="concierge-item">
                        <div class="concierge-icon"><i class="fa fa-cutlery"/></div>
                        <h4>Hotel restaurant</h4>
                        <p>Brazilian and international cuisine.</p>
                    </div>
                    <div class="concierge-item">
                        <div class="concierge-icon"><i class="fa fa-car"/></div>
                        <h4>Guarded parking</h4>
                        <p>CCTV monitored, free of charge.</p>
                    </div>
                    <div class="concierge-item">
                        <div class="concierge-icon"><i class="fa fa-wifi"/></div>
                        <h4>Free Wi-Fi</h4>
                        <p>Throughout the hotel, rooms included.</p>
                    </div>
                    <div class="concierge-item">
                        <div class="concierge-icon"><i class="fa fa-map"/></div>
                        <h4>Tourist materials</h4>
                        <p>Information about the area and trip suggestions.</p>
                    </div>
                    <div class="concierge-item">
                        <div class="concierge-icon"><i class="fa fa-suitcase"/></div>
                        <h4>Luggage storage</h4>
                        <p>Safe storage before check-in and after check-out.</p>
                    </div>
                    <div class="concierge-item">
                        <div class="concierge-icon"><i class="fa fa-tint"/></div>
                        <h4>Laundry and ironing</h4>
                        <p>For an extra charge, ready the next day.</p>
                    </div>
                    <div class="concierge-item">
                        <div class="concierge-icon"><i class="fa fa-clock-o"/></div>
                        <h4>Early / Late checkout</h4>
                        <p>Flexible times on request.</p>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Home About — Ubytování intro for homepage -->
    <template id="s_home_about" name="Intro - About us">
        <section class="s_home_about s_ha_home_about o_cc o_cc1 pt104 pb104 o_colored_level" data-snippet="s_home_about" data-name="Intro - About us">
            <div class="container">
                <div class="features-layout">
                    <div class="reveal">
                        <div class="section-tag">Rooms and apartments</div>
                        <h2 class="section-title">Accommodation</h2>
                        <p style="font-size:1.25rem;line-height:1.7;color:#C5C2BA;margin-bottom:2rem;">
                            The rooms at Hotel Arena are marked by a fresh, modern design. Each room has its own bathroom, satellite television, a safe and individually controlled air conditioning. A lift provides step-free access to every floor of the hotel.
                        </p>
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="concierge-item" style="padding:1.5rem;text-align:center;">
                                    <div class="concierge-icon"><i class="fa fa-wifi"/></div>
                                    <h4 style="font-size:1rem;">Free WiFi</h4>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="concierge-item" style="padding:1.5rem;text-align:center;">
                                    <div class="concierge-icon"><i class="fa fa-car"/></div>
                                    <h4 style="font-size:1rem;">Free parking</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="features-img reveal">
                        <img src="/theme_hotel_arena/static/src/img/homepage/o-nas2.webp" alt="Hotel Arena accommodation" loading="lazy"/>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Homepage - Restaurace section -->
    <template id="s_home_restaurant" name="Intro - Restaurant">
        <section class="s_home_restaurant s_ha_home_restaurant o_cc o_cc2 pt104 pb104 o_colored_level" data-snippet="s_home_restaurant" data-name="Intro - Restaurant">
            <div class="container">
                <div class="features-layout">
                    <div class="features-img reveal">
                        <img src="/theme_hotel_arena/static/src/img/homepage/uvodni-restaurace.webp" alt="Restaurant" loading="lazy"/>
                    </div>
                    <div class="reveal">
                        <div class="section-tag">Dining</div>
                        <h2 class="section-title">Restaurant</h2>
                        <p style="font-size:1.25rem;line-height:1.7;color:#C5C2BA;margin-bottom:2rem;">
                            Hotel Arena offers its guests not only ideal conditions for leisure activities but also high-quality dining in the newly opened hotel restaurant.</p>
                    </div>
                </div>
                <div class="features-layout" style="margin-top:5rem;">
                    <div class="reveal">
                        <div class="section-tag">Drinks</div>
                        <h2 class="section-title">Bar</h2>
                        <p style="font-size:1.25rem;line-height:1.7;color:#C5C2BA;">
                            You will also find a bar with us, suited to both private and business meetings. The bar staff are ready to meet your wishes.</p>
                    </div>
                    <div class="features-img reveal">
                        <img src="/theme_hotel_arena/static/src/img/homepage/uvodni-bar.webp" alt="Bar" loading="lazy"/>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Homepage - Concierge Services -->
    <template id="s_concierge_services" name="Concierge services">
        <section class="s_concierge_services s_ha_concierge o_cc o_cc1 pt104 pb104 o_colored_level" data-snippet="s_concierge_services" data-name="Concierge services">
            <div class="container">
                <div class="section-tag" style="justify-content:center;">
                    At your service
                </div>
                <h2 class="section-title" style="margin-bottom:1rem;">Concierge</h2>
                <p class="section-desc" style="max-width:650px;margin:0 auto 4rem;">
                    Whether you are planning a business trip, a family holiday or a sporting weekend — our team is here for you.</p>
                <div class="concierge-grid">
                    <div class="concierge-item reveal">
                        <div class="concierge-icon"><i class="fa fa-plane"/></div>
                        <h4>Airport transfers</h4>
                        <p>We will arrange a comfortable transfer straight to the hotel.</p>
                    </div>
                    <div class="concierge-item reveal">
                        <div class="concierge-icon"><i class="fa fa-ticket"/></div>
                        <h4>Tickets</h4>
                        <p>Cinema, theatre, concerts, hockey, football.</p>
                    </div>
                    <div class="concierge-item reveal">
                        <div class="concierge-icon"><i class="fa fa-cutlery"/></div>
                        <h4>Restaurant</h4>
                        <p>Reservations at restaurants in the area.</p>
                    </div>
                    <div class="concierge-item reveal">
                        <div class="concierge-icon"><i class="fa fa-compass"/></div>
                        <h4>Excursions</h4>
                        <p>Excursions arranged, tourist materials free of charge.</p>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>