                            <p style="color:#C5C2BA; margin-bottom: 0;">
                                <i class="fa fa-info-circle" style="color:#F07070; margin-right: 8px;"/>
                                For other guests: <strong>CZK 200 / person</strong></p>
                        </div>
                    </div>
                    <div class="col-lg-6 mt-4 mt-lg-0">
                        <div class="ha-img-hover-zoom" style="overflow: hidden;">
                            <img src="/theme_hotel_arena/static/src/img/homepage/snidane.webp" alt="Breakfast" class="img-fluid" loading="lazy"/>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>