<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Breakfast / Snídaně Section -->
    <template id="s_breakfast_info" name="Breakfast">
<section class="s_breakfast_info s_ha_breakfast o_cc o_cc1 pt104 pb104 o_colored_level" data-snippet="s_breakfast_info" data-name="Breakfast">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6">
                        <div class="ha-sub-title">Dining</div>
                        <h2 style="text-transform: uppercase; margin-bottom: 20px;">BREAKFAST</h2>
                        <p style="line-height: 1.8; color:#C5C2BA;">
                            Every morning we lay out a generous breakfast buffet with a choice of fresh pastries, cheeses, cold cuts, fruit and other treats.
                        </p>
                        <div class="mt-3" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.04); padding: 20px;">
                            <h5 style="text-transform: uppercase; margin-bottom: 15px;">Breakfast times</h5>
                            <p style="color:#C5C2BA; margin-bottom: 5px;">
                                <strong>Weekdays:</strong> 6:30 — 9:30</p>
                            <p style="color:#C5C2BA; margin-bottom: 15px;">
                                <strong>Weekends:</strong> 7:00 — 10:00</p>
                            <p style="color:#C5C2BA; margin-bottom: 0;">
                                <i class="fa fa-check" style="color:#F07070; margin-right: 8px;"/>
