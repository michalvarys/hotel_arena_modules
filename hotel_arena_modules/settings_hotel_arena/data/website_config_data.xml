<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Activate languages -->
        <record id="base.lang_cs_CZ" model="res.lang">
            <field name="active" eval="True"/>
        </record>
        <record id="base.lang_de" model="res.lang">
            <field name="active" eval="True"/>
        </record>
        <record id="base.lang_ru" model="res.lang">
            <field name="active" eval="True"/>
        </record>

        <!-- Website: default language cs_CZ, all 4 languages assigned -->
        <record id="website.default_website" model="website">
            <field name="default_lang_id" ref="base.lang_cs_CZ"/>
            <field name="language_ids" eval="[(6, 0, [
                ref('base.lang_cs_CZ'),
                ref('base.lang_de'),
                ref('base.lang_ru'),
                ref('base.lang_en'),
            ])]"/>
        </record>

    </data>
</odoo>
